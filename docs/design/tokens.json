{
  "name": "Guldr",
  "version": "1.0.0",
  "source": "Canvas 'Guldr — Identity proposal' (mockups/*.dc.html)",
  "color": {
    "AppBackground": {
      "light": "#F7F4EE",
      "dark": "#111111",
      "role": "Screen background"
    },
    "Surface": {
      "light": "#FFFFFF",
      "dark": "#1B1A18",
      "role": "Cards and circular buttons"
    },
    "SurfaceSecondary": {
      "light": "#EFEAE0",
      "dark": "#242220",
      "role": "Icon chips, search field, segmented control track"
    },
    "Field": {
      "light": "#FFFFFF",
      "dark": "#242220",
      "role": "Unselected category chips, add sheet field group"
    },
    "TextPrimary": {
      "light": "#141312",
      "dark": "#F2EEE6",
      "role": "Primary text and amounts"
    },
    "TextSecondary": {
      "light": "#6B665E",
      "dark": "#9C968C",
      "role": "Secondary text, metadata, inactive tabs"
    },
    "Hairline": {
      "light": "#E3DDD1",
      "dark": "#2C2A27",
      "role": "Card borders and separators"
    },
    "Track": {
      "light": "#EFEAE0",
      "dark": "#2C2A27",
      "role": "Progress bar and ring tracks"
    },
    "Gold": {
      "light": "#8A6A2E",
      "dark": "#C8A96A",
      "role": "Gold for TEXT and icons (active tab, links, percentages)"
    },
    "GoldFill": {
      "light": "#C8A96A",
      "dark": "#C8A96A",
      "role": "Gold for FILLS (add button, bars, rings, motif lines). Content on top: OnGold"
    },
    "GoldSoft": {
      "light": "#F3EAD7",
      "dark": "#2E271A",
      "role": "Selected category chip background"
    },
    "Positive": {
      "light": "#2F7D5B",
      "dark": "#5FB38A",
      "role": "Income"
    },
    "Negative": {
      "light": "#B4443C",
      "dark": "#E07A6E",
      "role": "Over-budget amounts and alerts"
    },
    "NegativeSoft": {
      "light": "#F6E4E0",
      "dark": "#2B1C1A",
      "role": "Over-budget alert background"
    },
    "OnGold": {
      "light": "#111111",
      "dark": "#111111",
      "role": "Text/icons on GoldFill"
    },
    "Chart1": {
      "light": "#8A6A2E",
      "dark": "#E2CB97",
      "role": "Category chart series 1 (largest to smallest)"
    },
    "Chart2": {
      "light": "#B08D4E",
      "dark": "#C8A96A",
      "role": "Category chart series 2 (largest to smallest)"
    },
    "Chart3": {
      "light": "#C8A96A",
      "dark": "#A08650",
      "role": "Category chart series 3 (largest to smallest)"
    },
    "Chart4": {
      "light": "#DCC59A",
      "dark": "#76623C",
      "role": "Category chart series 4 (largest to smallest)"
    },
    "Chart5": {
      "light": "#4A4640",
      "dark": "#E8E3DA",
      "role": "Category chart series 5 (largest to smallest)"
    },
    "Chart6": {
      "light": "#8A847A",
      "dark": "#A8A298",
      "role": "Category chart series 6 (largest to smallest)"
    },
    "Chart7": {
      "light": "#C4BEB3",
      "dark": "#5E5A54",
      "role": "Category chart series 7 (largest to smallest)"
    },
    "CategoryGold": {
      "light": "#A9872A",
      "dark": "#BB9A46",
      "role": "Category base color 'gold' (ADR 009)"
    },
    "CategoryAmber": {
      "light": "#B26417",
      "dark": "#C87E41",
      "role": "Category base color 'amber' (ADR 009)"
    },
    "CategoryTerracotta": {
      "light": "#A64832",
      "dark": "#C2644F",
      "role": "Category base color 'terracotta' (ADR 009)"
    },
    "CategoryWine": {
      "light": "#873046",
      "dark": "#AB5064",
      "role": "Category base color 'wine' (ADR 009)"
    },
    "CategoryRose": {
      "light": "#BA678D",
      "dark": "#CD80A2",
      "role": "Category base color 'rose' (ADR 009)"
    },
    "CategoryPlum": {
      "light": "#794880",
      "dark": "#97649F",
      "role": "Category base color 'plum' (ADR 009)"
    },
    "CategoryIndigo": {
      "light": "#6F6DB9",
      "dark": "#8383CD",
      "role": "Category base color 'indigo' (ADR 009)"
    },
    "CategoryBlue": {
      "light": "#295D94",
      "dark": "#497DB7",
      "role": "Category base color 'blue' (ADR 009)"
    },
    "CategorySky": {
      "light": "#3A95B9",
      "dark": "#58AACD",
      "role": "Category base color 'sky' (ADR 009)"
    },
    "CategoryTeal": {
      "light": "#017976",
      "dark": "#349794",
      "role": "Category base color 'teal' (ADR 009)"
    },
    "CategoryGreen": {
      "light": "#4A925C",
      "dark": "#66A774",
      "role": "Category base color 'green' (ADR 009)"
    },
    "CategoryOlive": {
      "light": "#65690F",
      "dark": "#82863A",
      "role": "Category base color 'olive' (ADR 009)"
    },
    "CategoryGraphite": {
      "light": "#6F6B65",
      "dark": "#8F8C85",
      "role": "Category base color 'graphite' (ADR 009)"
    }
  },
  "typography": {
    "display": {
      "family": "New York (Font.Design.serif)",
      "usage": "Large amounts and brand moments only",
      "sizes_pt": {
        "balance": 46,
        "balanceCents": 26,
        "addAmount": 58,
        "budgetRingCenter": 30,
        "widgetSmall": 28,
        "widgetMedium": 26,
        "donutCenter": 20
      },
      "numerals": "tabular (monospacedDigit)"
    },
    "ui": {
      "family": "SF Pro (Font.Design.default)",
      "styles": {
        "largeTitle": {
          "size": 34,
          "weight": "bold",
          "tracking_em": -0.02
        },
        "sectionTitle": {
          "size": 20,
          "weight": "bold",
          "tracking_em": -0.01
        },
        "amountRow": {
          "size": 16,
          "weight": "semibold",
          "numerals": "tabular"
        },
        "rowTitle": {
          "size": 16,
          "weight": "semibold"
        },
        "cardTitle": {
          "size": 15,
          "weight": "semibold"
        },
        "summaryValue": {
          "size": 19,
          "weight": "semibold",
          "numerals": "tabular"
        },
        "meta": {
          "size": 13,
          "weight": "regular"
        },
        "overline": {
          "size": 12,
          "weight": "semibold",
          "tracking_em": 0.1,
          "case": "uppercase"
        },
        "tabLabel": {
          "size": 10,
          "weight": "semibold"
        }
      }
    },
    "wordmark": {
      "family": "Manrope SemiBold (fonts/Manrope-SemiBold.ttf, PostScript: Manrope-SemiBold)",
      "case": "lowercase",
      "tracking_em": {
        "large": -0.045,
        "header": -0.04
      },
      "assets": "wordmark/*.svg"
    }
  },
  "radius_pt": {
    "phoneCard": 28,
    "card": 24,
    "compactCard": 22,
    "alert": 18,
    "field": 16,
    "categoryChip": 14,
    "keypadKey": 14,
    "iconChipLarge": 13,
    "iconChip": 12,
    "segmented": 12,
    "segmentedThumb": 9,
    "progressBar": 3,
    "pill": 999
  },
  "spacing_pt": {
    "screenHorizontal": 20,
    "screenTop": 64,
    "stackDefault": 16,
    "stackCompact": 10,
    "cardPadding": 22,
    "cardPaddingCompact": 18,
    "rowVertical": 8,
    "rowGap": 12
  },
  "size_pt": {
    "iconChip": 42,
    "iconChipCompact": 40,
    "iconChipBudget": 38,
    "iconGlyph": 20,
    "iconGlyphCompact": 19,
    "iconGlyphBudget": 18,
    "tabBarHeight": 64,
    "addButton": 64,
    "touchTargetMin": 44,
    "progressBarHeight": 6,
    "progressBarHeightCompact": 5,
    "budgetRing": 168,
    "budgetRingStroke": 12,
    "miniRing": 44,
    "miniRingStroke": 5
  },
  "motif": {
    "name": "Ledger lines",
    "lines": [
      {
        "widthPct": 100,
        "opacity": 1.0
      },
      {
        "widthPct": 78,
        "opacity": 0.5
      },
      {
        "widthPct": 56,
        "opacity": 0.25
      }
    ],
    "thickness_pt": 1,
    "gap_pt": 5,
    "color": "GoldFill"
  },
  "shadow": {
    "light": [
      {
        "y": 1,
        "blur": 2,
        "color": "#141312",
        "opacity": 0.04
      },
      {
        "y": 10,
        "blur": 30,
        "color": "#141312",
        "opacity": 0.06
      }
    ],
    "dark": "none (use Hairline border instead)"
  },
  "icon": {
    "glyph": "icon/guldr-glyph-*.svg (1024x1024, transparent background)",
    "background": {
      "default": "#111111",
      "light": "#FFFFFF",
      "tinted": "#2A2826"
    },
    "glyphColor": {
      "default": "#C8A96A",
      "light": "#8A6A2E",
      "tinted": "#D9D4CB"
    }
  },
  "motion": {
    "standard": {
      "swiftui": ".smooth(duration: 0.35)",
      "duration_s": 0.35,
      "use": "Layout and value changes"
    },
    "snappy": {
      "swiftui": ".snappy(duration: 0.25)",
      "duration_s": 0.25,
      "use": "Direct manipulation: chips, keypad, segmented controls, toggles"
    },
    "emphasized": {
      "swiftui": ".spring(duration: 0.45, bounce: 0.15)",
      "duration_s": 0.45,
      "bounce": 0.15,
      "use": "Success moments only"
    },
    "reveal": {
      "swiftui": ".smooth(duration: 0.6)",
      "duration_s": 0.6,
      "use": "First appearance of fills and the ledger lines"
    },
    "stagger": {
      "step_s": 0.04,
      "max_total_s": 0.25
    },
    "reduceMotion": {
      "crossFade": {
        "swiftui": ".easeInOut(duration: 0.2)",
        "duration_s": 0.2
      },
      "keeps": [
        "numericText",
        "haptics"
      ]
    },
    "haptics": {
      "selection": "selection",
      "keypadKey": "impact(weight: .light)",
      "saved": "success",
      "budgetExceeded": "warning",
      "unlockFailed": "error"
    }
  }
}